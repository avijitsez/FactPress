{#-
  pulse_update — compact recurring "hourly pulse" status card.
  Consumes the render context defined in docs/rendering-contract.md:
  W, H, size ("feed" | "telegram"), spec, brand {fonts, logo_text, watermark,
  palette}, view {headline, subhead, emoji, hero, delta_chips, callouts,
  sparkline, as_of, footer}.

  Deliberately the opposite of daily_pnl's drama: the "as of" timestamp is
  the glanceability anchor and renders LARGER than the headline, the hero
  metric is a modest mid-size figure (not an oversized viral hero), the
  gradient wash is reduced to the small brand-mark accent only, and the
  sparkline is intentionally tiny (scaled down from the engine's fixed
  420x96 path box) so density stays high and calm.

  No formatting logic here -- every numeral in `view` already arrives fully
  formatted by the renderer. This template only lays things out.
-#}
{%- set pal = brand.palette -%}
{%- set sans = brand.fonts.sans -%}
{%- set mono = brand.fonts.mono -%}

{%- macro arrow_glyph(d) -%}
{%- if d == 'up' -%}▲{%- elif d == 'down' -%}▼{%- else -%}●{%- endif -%}
{%- endmacro -%}

{%- macro dir_color(d) -%}
{%- if d == 'up' -%}{{ pal.positive }}{%- elif d == 'down' -%}{{ pal.negative }}{%- else -%}{{ pal.muted }}{%- endif -%}
{%- endmacro -%}

{%- macro hero_fill() -%}
{%- if view.hero.color_role == 'positive' -%}{{ pal.positive }}{%- elif view.hero.color_role == 'negative' -%}{{ pal.negative }}{%- else -%}{{ pal.fg }}{%- endif -%}
{%- endmacro -%}

{%- set margin = W * 0.065 -%}
{%- set safe_w = W - margin * 2 -%}
{%- set logo_size = [W * 0.020, 16] | max -%}
{%- set footer_size = [W * 0.013, 11] | max -%}
{%- set header_baseline = margin + logo_size -%}
{%- set spark_scale = 0.60 -%}

<svg width="{{ W }}" height="{{ H }}" viewBox="0 0 {{ W }} {{ H }}" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="accentGradV" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="{{ pal.grad_from }}"/>
      <stop offset="100%" stop-color="{{ pal.grad_to }}"/>
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="{{ W }}" height="{{ H }}" fill="{{ pal.bg }}"/>

  {#- brand mark: small gradient accent bar beside the logo text -- the
      only gradient on this card; no diagonal wash (calm, not viral). -#}
  <rect x="{{ margin }}" y="{{ header_baseline - logo_size * 0.78 }}"
        width="{{ logo_size * 0.34 }}" height="{{ logo_size * 0.78 }}"
        rx="{{ logo_size * 0.12 }}" fill="url(#accentGradV)"/>
  <text x="{{ margin + logo_size * 0.55 }}" y="{{ header_baseline }}"
        font-family="{{ sans }}" font-weight="700" font-size="{{ logo_size }}"
        fill="{{ pal.fg }}">{{ brand.logo_text }}</text>

{%- if size == 'feed' %}
{#- ============================== FEED (portrait, stacked) ============================== -#}
  {%- set as_of_label_size = [W * 0.014, 11] | max -%}
  {%- set as_of_size = [W * 0.050, 28] | max -%}
  {%- set headline_size = [W * 0.032, 20] | max -%}
  {%- set subhead_size = [W * 0.019, 14] | max -%}
  {%- set hero_label_size = [W * 0.018, 13] | max -%}
  {%- set hero_value_size = W * 0.115 -%}
  {%- set chip_h = [H * 0.052, 46] | max -%}
  {%- set chip_label_size = [W * 0.0135, 10] | max -%}
  {%- set chip_value_size = [W * 0.019, 14] | max -%}
  {%- set callout_value_size = [W * 0.017, 13] | max -%}
  {%- set callout_label_size = [W * 0.0125, 10] | max -%}

  {%- set ns = namespace(y = margin + logo_size + margin * 0.9) -%}

  {#- "as of" anchor: the glanceability landmark, deliberately larger than
      the headline below it -#}
  {%- if view.as_of %}
  {%- set ns.y = ns.y + as_of_label_size %}
  <text x="{{ margin }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="600"
        font-size="{{ as_of_label_size }}" letter-spacing="1"
        fill="{{ pal.muted }}">AS OF</text>
  {%- set ns.y = ns.y + as_of_size + margin * 0.15 %}
  <text x="{{ margin }}" y="{{ ns.y }}" font-family="{{ mono }}" font-weight="700"
        font-size="{{ as_of_size }}" fill="{{ pal.fg }}">{{ view.as_of }}</text>
  {%- set ns.y = ns.y + margin * 0.55 %}
  {%- endif %}

  {#- headline: modest -- this card's hero is the timestamp, not the copy -#}
  {%- set ns.y = ns.y + headline_size %}
  <text x="{{ margin }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="700"
        font-size="{{ headline_size }}" fill="{{ pal.fg }}">{{ view.headline }}</text>

  {%- if view.subhead %}
  {%- set ns.y = ns.y + subhead_size + margin * 0.3 %}
  <text x="{{ margin }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ subhead_size }}" fill="{{ pal.muted }}">{{ view.subhead }}</text>
  {%- endif %}

  {#- hero block: medium, not oversized -#}
  {%- set hero_y = H * 0.475 %}
  <text x="{{ margin }}" y="{{ hero_y - hero_value_size * 0.88 }}"
        font-family="{{ sans }}" font-weight="600" font-size="{{ hero_label_size }}"
        fill="{{ pal.muted }}">{{ view.hero.label }}</text>
  <text x="{{ margin }}" y="{{ hero_y }}"
        font-family="{{ mono }}" font-weight="700" font-size="{{ hero_value_size }}"
        fill="{{ hero_fill() }}"><tspan font-size="{{ hero_value_size * 0.46 }}">{{ arrow_glyph(view.hero.direction) }} </tspan>{{ view.hero.value }}</text>

  {%- set ns.y = hero_y + hero_value_size * 0.36 + margin * 0.85 %}

  {#- delta chips row: e.g. open positions, orders used -#}
  {%- set n_chips = view.delta_chips | length -%}
  {%- if n_chips > 0 %}
  {%- set chip_gap = margin * 0.4 -%}
  {%- set chip_w = (safe_w - chip_gap * (n_chips - 1)) / n_chips -%}
  {%- for chip in view.delta_chips %}
  {%- set cx = margin + loop.index0 * (chip_w + chip_gap) %}
  <rect x="{{ cx }}" y="{{ ns.y }}" width="{{ chip_w }}" height="{{ chip_h }}"
        rx="{{ chip_h / 2 }}" fill="{{ pal.chip_bg }}"/>
  <text x="{{ cx + chip_w * 0.5 }}" y="{{ ns.y + chip_h * 0.40 }}" text-anchor="middle"
        font-family="{{ sans }}" font-weight="400" font-size="{{ chip_label_size }}"
        fill="{{ pal.muted }}">{{ chip.label }}</text>
  <text x="{{ cx + chip_w * 0.5 }}" y="{{ ns.y + chip_h * 0.76 }}" text-anchor="middle"
        font-family="{{ mono }}" font-weight="700" font-size="{{ chip_value_size }}"
        fill="{{ dir_color(chip.direction) }}">{{ arrow_glyph(chip.direction) }} {{ chip.value }}</text>
  {%- endfor %}
  {%- set ns.y = ns.y + chip_h + margin * 0.7 %}
  {%- endif %}

  {#- callouts row: e.g. orders cap -#}
  {%- set n_callouts = view.callouts | length -%}
  {%- if n_callouts > 0 %}
  {%- set co_gap = margin * 0.4 -%}
  {%- set co_w = (safe_w - co_gap * (n_callouts - 1)) / n_callouts -%}
  {%- for co in view.callouts %}
  {%- set cx = margin + loop.index0 * (co_w + co_gap) %}
  <text x="{{ cx }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ callout_label_size }}" fill="{{ pal.muted }}">{{ co.label }}</text>
  <text x="{{ cx }}" y="{{ ns.y + callout_value_size + 4 }}" font-family="{{ mono }}"
        font-weight="700" font-size="{{ callout_value_size }}" fill="{{ pal.fg }}">{{ co.value }}</text>
  {%- endfor %}
  {%- set ns.y = ns.y + callout_value_size + margin * 0.75 %}
  {%- endif %}

  {#- tiny sparkline, in a calm surface panel -- scaled down from the
      engine's fixed 420x96 path box so it reads as a discreet strip -#}
  {%- if view.sparkline %}
  {%- set sw = view.sparkline.w * spark_scale -%}
  {%- set sh = view.sparkline.h * spark_scale -%}
  {%- set sx = margin %}
  <rect x="{{ sx - margin * 0.35 }}" y="{{ ns.y - margin * 0.25 }}"
        width="{{ sw + margin * 0.7 }}" height="{{ sh + margin * 0.5 }}"
        rx="{{ margin * 0.28 }}" fill="{{ pal.surface }}"/>
  <g transform="translate({{ sx }} {{ ns.y }}) scale({{ spark_scale }})">
    <path d="{{ view.sparkline.area_path }}" fill="{{ pal.accent }}" opacity="0.20" stroke="none"/>
    <path d="{{ view.sparkline.path }}" fill="none" stroke="{{ pal.accent }}" stroke-width="3"
          stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  {%- endif %}

{%- else %}
{#- ============================== TELEGRAM (landscape, two-column) ============================== -#}
  {%- set col_split = W * 0.52 -%}
  {%- set left_x = margin -%}
  {%- set left_w = col_split - margin -%}
  {%- set right_x = col_split + margin * 0.5 -%}
  {%- set right_w = W - right_x - margin -%}

  {%- set as_of_label_size = [W * 0.012, 10] | max -%}
  {%- set as_of_size = [W * 0.036, 22] | max -%}
  {%- set headline_size = [W * 0.024, 16] | max -%}
  {%- set subhead_size = [W * 0.015, 12] | max -%}
  {%- set hero_label_size = [W * 0.015, 11] | max -%}
  {%- set hero_value_size = H * 0.145 -%}
  {%- set chip_h = [H * 0.10, 36] | max -%}
  {%- set chip_label_size = [W * 0.0115, 9] | max -%}
  {%- set chip_value_size = [W * 0.015, 12] | max -%}
  {%- set callout_value_size = [W * 0.014, 11] | max -%}
  {%- set callout_label_size = [W * 0.0105, 9] | max -%}

  {%- set lns = namespace(y = margin + logo_size + margin * 1.0) -%}

  {%- if view.as_of %}
  {%- set lns.y = lns.y + as_of_label_size %}
  <text x="{{ left_x }}" y="{{ lns.y }}" font-family="{{ sans }}" font-weight="600"
        font-size="{{ as_of_label_size }}" letter-spacing="1"
        fill="{{ pal.muted }}">AS OF</text>
  {%- set lns.y = lns.y + as_of_size + margin * 0.12 %}
  <text x="{{ left_x }}" y="{{ lns.y }}" font-family="{{ mono }}" font-weight="700"
        font-size="{{ as_of_size }}" fill="{{ pal.fg }}">{{ view.as_of }}</text>
  {%- set lns.y = lns.y + margin * 0.45 %}
  {%- endif %}

  {%- set lns.y = lns.y + headline_size %}
  <text x="{{ left_x }}" y="{{ lns.y }}" font-family="{{ sans }}" font-weight="700"
        font-size="{{ headline_size }}" fill="{{ pal.fg }}">{{ view.headline }}</text>

  {%- if view.subhead %}
  {%- set lns.y = lns.y + subhead_size + margin * 0.25 %}
  <text x="{{ left_x }}" y="{{ lns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ subhead_size }}" fill="{{ pal.muted }}">{{ view.subhead }}</text>
  {%- endif %}

  {#- hero block anchored in the lower half of the left column -#}
  {%- set hero_y = H * 0.80 %}
  <text x="{{ left_x }}" y="{{ hero_y - hero_value_size * 0.85 }}"
        font-family="{{ sans }}" font-weight="600" font-size="{{ hero_label_size }}"
        fill="{{ pal.muted }}">{{ view.hero.label }}</text>
  <text x="{{ left_x }}" y="{{ hero_y }}"
        font-family="{{ mono }}" font-weight="700" font-size="{{ hero_value_size }}"
        fill="{{ hero_fill() }}"><tspan font-size="{{ hero_value_size * 0.44 }}">{{ arrow_glyph(view.hero.direction) }} </tspan>{{ view.hero.value }}</text>

  {%- set rns = namespace(y = margin + logo_size + margin * 1.0) -%}

  {#- delta chips: stacked vertically down the right column -#}
  {%- set n_chips = view.delta_chips | length -%}
  {%- if n_chips > 0 %}
  {%- set chip_gap = margin * 0.28 -%}
  {%- for chip in view.delta_chips %}
  <rect x="{{ right_x }}" y="{{ rns.y }}" width="{{ right_w }}" height="{{ chip_h }}"
        rx="{{ chip_h / 2 }}" fill="{{ pal.chip_bg }}"/>
  <text x="{{ right_x + right_w * 0.5 }}" y="{{ rns.y + chip_h * 0.40 }}" text-anchor="middle"
        font-family="{{ sans }}" font-weight="400" font-size="{{ chip_label_size }}"
        fill="{{ pal.muted }}">{{ chip.label }}</text>
  <text x="{{ right_x + right_w * 0.5 }}" y="{{ rns.y + chip_h * 0.78 }}" text-anchor="middle"
        font-family="{{ mono }}" font-weight="700" font-size="{{ chip_value_size }}"
        fill="{{ dir_color(chip.direction) }}">{{ arrow_glyph(chip.direction) }} {{ chip.value }}</text>
  {%- set rns.y = rns.y + chip_h + chip_gap %}
  {%- endfor %}
  {%- endif %}

  {#- callouts: stacked label/value rows in the right column -#}
  {%- if view.callouts | length > 0 %}
  {%- set rns.y = rns.y + margin * 0.15 %}
  {%- for co in view.callouts %}
  <text x="{{ right_x }}" y="{{ rns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ callout_label_size }}" fill="{{ pal.muted }}">{{ co.label }}</text>
  <text x="{{ right_x + right_w }}" y="{{ rns.y }}" text-anchor="end" font-family="{{ mono }}"
        font-weight="700" font-size="{{ callout_value_size }}" fill="{{ pal.fg }}">{{ co.value }}</text>
  {%- set rns.y = rns.y + callout_value_size + margin * 0.22 %}
  {%- endfor %}
  {%- endif %}

  {#- tiny sparkline, fills the rest of the right column -#}
  {%- if view.sparkline %}
  {%- set sw = view.sparkline.w * spark_scale -%}
  {%- set sh = view.sparkline.h * spark_scale -%}
  {%- set rns.y = rns.y + margin * 0.2 %}
  <rect x="{{ right_x - margin * 0.2 }}" y="{{ rns.y - margin * 0.2 }}"
        width="{{ [sw + margin * 0.4, right_w] | min }}"
        height="{{ sh + margin * 0.4 }}"
        rx="{{ margin * 0.22 }}" fill="{{ pal.surface }}"/>
  <g transform="translate({{ right_x }} {{ rns.y }}) scale({{ spark_scale }})">
    <path d="{{ view.sparkline.area_path }}" fill="{{ pal.accent }}" opacity="0.20" stroke="none"/>
    <path d="{{ view.sparkline.path }}" fill="none" stroke="{{ pal.accent }}" stroke-width="3"
          stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  {%- endif %}
{%- endif %}

  <!-- footer + watermark -->
  <text x="{{ margin }}" y="{{ H - margin * 0.55 }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ footer_size }}" fill="{{ pal.muted }}">{{ view.footer }}</text>
  {%- if brand.watermark %}
  <text x="{{ W - margin }}" y="{{ H - margin * 0.55 }}" text-anchor="end"
        font-family="{{ sans }}" font-weight="700" font-size="{{ footer_size }}"
        fill="{{ pal.muted }}" opacity="0.6">{{ brand.logo_text }}</text>
  {%- endif %}
</svg>
