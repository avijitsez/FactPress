{#-
  trade_proposal — F5 Interactive Approval Channel template (single
  "default" variant; FACTPRESS_DESIGN.md §7). Consumes the render context
  defined in docs/rendering-contract.md: W, H, size ("feed" | "telegram"),
  spec, brand {fonts, logo_text, watermark, palette}, view {headline,
  subhead, hero, delta_chips, callouts, as_of, footer, text_fields}, plus
  the interactive-only `state` entry ({"name","decider","stamped_at","note"}
  | None) built by the engine from a StateInfo — never art-directed by the
  creative-director LLM.

  Proposal body (director-controlled content, exactly like one-way
  templates): symbol (headline) + side badge, hero = spec-chosen metric
  (fixtures use limit_price), qty/confidence as delta chips, plan
  target/stop as callouts, an optional risk_note line.

  Side badge text/color: `view.text_fields.side` carries the facts'
  `side` field through the engine's host-text whitelist. There is NO
  default: a proposal whose facts omit side renders no badge at all --
  a missing badge is honest, a guessed one would put a false fact on
  the card.

  State layers (engine-applied, deterministic, zero director control):
  rendered strictly on top of the body via one shared `state_stamp` /
  `state_ribbon` macro pair, branched on `state.name`. Never covers the
  symbol -- ribbon sits in the top margin above the logo, stamps sit in a
  fixed band near the footer, well below all body content at every size.

  No formatting logic here -- every numeral in `view` already arrives
  fully formatted by the renderer. This template only lays things out.
-#}
{%- set pal = brand.palette -%}
{%- set sans = brand.fonts.sans -%}
{%- set mono = brand.fonts.mono -%}

{%- macro arrow_glyph(d) -%}
{%- if d == 'up' -%}▲{%- elif d == 'down' -%}▼{%- else -%}●{%- endif -%}
{%- endmacro -%}

{%- macro dir_color(d) -%}
{%- if d == 'up' -%}{{ pal.positive }}{%- elif d == 'down' -%}{{ pal.negative }}{%- else -%}{{ pal.muted }}{%- endif -%}
{%- endmacro -%}

{%- macro hero_fill() -%}
{%- if view.hero.color_role == 'positive' -%}{{ pal.positive }}{%- elif view.hero.color_role == 'negative' -%}{{ pal.negative }}{%- else -%}{{ pal.fg }}{%- endif -%}
{%- endmacro -%}

{#- side badge from facts.side via the engine whitelist; NO default -- a
    missing side renders no badge rather than a guessed (false) one -#}
{%- set side_label = none -%}
{%- if view.text_fields is defined and view.text_fields.side is defined and view.text_fields.side -%}
  {%- set side_label = view.text_fields.side | upper -%}
{%- endif -%}
{%- set side_color = pal.negative if side_label == 'SELL' else pal.positive -%}

{%- set margin = W * 0.065 -%}
{%- set safe_w = W - margin * 2 -%}
{%- set logo_size = [W * 0.020, 16] | max -%}
{%- set meta_size = [W * 0.0145, 12] | max -%}
{%- set footer_size = [W * 0.013, 11] | max -%}
{%- set header_baseline = margin + logo_size -%}
{%- set badge_h = [H * 0.032, 26] | max -%}
{%- set badge_size = [W * 0.0155, 12] | max -%}

{#- shared state-layer geometry: a top ribbon (pending) that fits inside
    the header margin, and a bottom stamp band that sits below every body
    element at both sizes -- so the symbol can never be covered. -#}
{%- set ribbon_h = margin * 0.75 -%}
{%- set ribbon_text_size = [W * 0.016, 13] | max -%}
{%- set stamp_x = margin -%}
{%- set stamp_w = W - margin * 2 -%}
{%- set stamp_h = H * 0.12 -%}
{%- set stamp_y = H * 0.78 -%}
{%- set stamp_title_size = [W * 0.028, 20] | max -%}
{%- set stamp_title_y = stamp_h * 0.42 -%}
{%- set stamp_sub_size = [W * 0.016, 13] | max -%}
{%- set stamp_sub_gap = stamp_h * 0.05 -%}
{%- set stamp_border = [W * 0.003, 2] | max -%}

{%- macro state_ribbon(text, color) -%}
<rect x="0" y="0" width="{{ W }}" height="{{ ribbon_h }}" fill="{{ color }}" opacity="0.16"/>
<rect x="0" y="{{ ribbon_h - ribbon_h * 0.08 }}" width="{{ W }}" height="{{ ribbon_h * 0.08 }}"
      fill="{{ color }}" opacity="0.4"/>
<text x="{{ W / 2 }}" y="{{ ribbon_h * 0.64 }}" text-anchor="middle" font-family="{{ sans }}"
      font-weight="700" font-size="{{ ribbon_text_size }}" fill="{{ color }}"
      letter-spacing="3">{{ text }}</text>
{%- endmacro -%}

{%- macro state_stamp(title, color, lines) -%}
<rect x="{{ stamp_x }}" y="{{ stamp_y }}" width="{{ stamp_w }}" height="{{ stamp_h }}"
      rx="{{ stamp_h * 0.16 }}" fill="{{ pal.surface }}" opacity="0.97"
      stroke="{{ color }}" stroke-width="{{ stamp_border }}"/>
<text x="{{ W / 2 }}" y="{{ stamp_y + stamp_title_y }}" text-anchor="middle"
      font-family="{{ sans }}" font-weight="800" font-size="{{ stamp_title_size }}"
      fill="{{ color }}" letter-spacing="2">{{ title }}</text>
{%- for line in lines %}
<text x="{{ W / 2 }}" y="{{ stamp_y + stamp_title_y + stamp_sub_size * loop.index + stamp_sub_gap * (loop.index - 1) }}"
      text-anchor="middle" font-family="{{ sans }}" font-weight="400"
      font-size="{{ stamp_sub_size }}" fill="{{ pal.muted }}">{{ line }}</text>
{%- endfor %}
{%- endmacro -%}

{#- resolve the active state's title/color once, shared by both size branches -#}
{%- set st_title = '' -%}
{%- set st_color = pal.muted -%}
{%- if state %}
  {%- if state.name == 'pending' -%}
    {%- set st_title = 'AWAITING APPROVAL' -%}
    {%- set st_color = pal.accent -%}
  {%- elif state.name == 'approved' -%}
    {%- set st_title = 'APPROVED' -%}
    {%- set st_color = pal.positive -%}
  {%- elif state.name == 'rejected' -%}
    {%- set st_title = 'REJECTED' -%}
    {%- set st_color = pal.negative -%}
  {%- elif state.name == 'executed' -%}
    {%- set st_title = 'EXECUTED ✓' -%}
    {%- set st_color = pal.positive -%}
  {%- elif state.name == 'failed' -%}
    {%- set st_title = 'FAILED ✗' -%}
    {%- set st_color = pal.negative -%}
  {%- elif state.name == 'expired' -%}
    {%- set st_title = 'EXPIRED' -%}
    {%- set st_color = pal.muted -%}
  {%- endif %}
  {%- set decider_line = ('Decided by ' ~ state.decider) if (state.decider and state.name in ['approved', 'rejected']) else None -%}
  {%- set stamped_line = state.stamped_at if state.stamped_at else None -%}
  {%- set note_line = state.note if (state.note and state.name in ['executed', 'failed']) else None -%}
  {%- set microcopy_line = 'No action was taken.' if state.name == 'expired' else None -%}
  {%- set st_lines = [decider_line, stamped_line, note_line, microcopy_line] | select | list -%}
{%- endif %}

<svg width="{{ W }}" height="{{ H }}" viewBox="0 0 {{ W }} {{ H }}" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="{{ pal.grad_from }}"/>
      <stop offset="100%" stop-color="{{ pal.grad_to }}"/>
    </linearGradient>
    <linearGradient id="accentGradV" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="{{ pal.grad_from }}"/>
      <stop offset="100%" stop-color="{{ pal.grad_to }}"/>
    </linearGradient>
    {%- if state and state.name == 'expired' %}
    <filter id="expiredDesaturate">
      <feColorMatrix type="saturate" values="0.12"/>
    </filter>
    {%- endif %}
  </defs>

  {%- if state and state.name == 'expired' %}
  <g filter="url(#expiredDesaturate)">
  {%- endif %}

  <rect x="0" y="0" width="{{ W }}" height="{{ H }}" fill="{{ pal.bg }}"/>

  <!-- gradient accent wash: a large soft diagonal shape behind the header -->
  <rect x="{{ W * 0.30 }}" y="{{ H * -0.22 }}" width="{{ W * 0.95 }}" height="{{ H * 0.5 }}"
        rx="{{ margin }}" fill="url(#accentGrad)" opacity="0.14"
        transform="rotate(-10 {{ W / 2 }} {{ H * 0.05 }})"/>

  <!-- brand mark: small gradient accent bar beside the logo text -->
  <rect x="{{ margin }}" y="{{ header_baseline - logo_size * 0.78 }}"
        width="{{ logo_size * 0.34 }}" height="{{ logo_size * 0.78 }}"
        rx="{{ logo_size * 0.12 }}" fill="url(#accentGradV)"/>
  <text x="{{ margin + logo_size * 0.55 }}" y="{{ header_baseline }}"
        font-family="{{ sans }}" font-weight="700" font-size="{{ logo_size }}"
        fill="{{ pal.fg }}">{{ brand.logo_text }}</text>

  {%- if view.as_of %}
  <text x="{{ W - margin }}" y="{{ header_baseline }}" text-anchor="end"
        font-family="{{ sans }}" font-weight="400" font-size="{{ meta_size }}"
        fill="{{ pal.muted }}">{{ view.as_of }}</text>
  {%- endif %}

{%- if size == 'feed' %}
{#- ============================== FEED (portrait, stacked) ============================== -#}
  {%- set headline_size = [W * 0.075, 40] | max -%}
  {%- set risk_note_size = [W * 0.022, 14] | max -%}
  {%- set hero_label_size = [W * 0.020, 14] | max -%}
  {%- set hero_value_size = W * 0.130 -%}
  {%- set chip_h = [H * 0.058, 54] | max -%}
  {%- set chip_label_size = [W * 0.0145, 11] | max -%}
  {%- set chip_value_size = [W * 0.021, 15] | max -%}
  {%- set callout_value_size = [W * 0.024, 17] | max -%}
  {%- set callout_label_size = [W * 0.0145, 11] | max -%}

  {%- set ns = namespace(y = margin + logo_size + margin * 1.05) -%}
  {%- set ns.y = ns.y + badge_h %}

  {#- side badge (BUY / SELL) above the symbol -#}
  {% if side_label %}
  <rect x="{{ margin }}" y="{{ ns.y - badge_h }}" width="{{ badge_h * 2.5 }}" height="{{ badge_h }}"
        rx="{{ badge_h / 2 }}" fill="{{ side_color }}" opacity="0.18"/>
  <text x="{{ margin + badge_h * 1.25 }}" y="{{ ns.y - badge_h * 0.32 }}" text-anchor="middle"
        font-family="{{ sans }}" font-weight="700" font-size="{{ badge_size }}"
        fill="{{ side_color }}">{{ side_label }}</text>
  {% endif %}

  {%- set ns.y = ns.y + headline_size + margin * 0.55 %}
  {#- symbol, huge -#}
  <text x="{{ margin }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="800"
        font-size="{{ headline_size }}" fill="{{ pal.fg }}">{{ view.headline }}</text>

  {%- if view.subhead %}
  {%- set ns.y = ns.y + risk_note_size + margin * 0.35 %}
  <text x="{{ margin }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ risk_note_size }}" fill="{{ pal.muted }}">{{ view.subhead }}</text>
  {%- endif %}

  {%- if view.text_fields is defined and view.text_fields.risk_note is defined and view.text_fields.risk_note %}
  {%- set ns.y = ns.y + risk_note_size + margin * 0.35 %}
  <text x="{{ margin }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ risk_note_size }}" fill="{{ pal.accent }}">{{ view.text_fields.risk_note }}</text>
  {%- endif %}

  {#- hero block -#}
  {%- set hero_y = H * 0.44 %}
  <text x="{{ W / 2 }}" y="{{ hero_y - hero_value_size * 0.95 }}" text-anchor="middle"
        font-family="{{ sans }}" font-weight="600" font-size="{{ hero_label_size }}"
        fill="{{ pal.muted }}">{{ view.hero.label }}</text>
  <text x="{{ W / 2 }}" y="{{ hero_y }}" text-anchor="middle"
        font-family="{{ mono }}" font-weight="700" font-size="{{ hero_value_size }}"
        fill="{{ hero_fill() }}"><tspan font-size="{{ hero_value_size * 0.5 }}">{{ arrow_glyph(view.hero.direction) }} </tspan>{{ view.hero.value }}</text>

  {%- set ns.y = hero_y + hero_value_size * 0.42 + margin * 0.9 %}

  {#- delta chips row: qty + confidence -#}
  {%- set n_chips = view.delta_chips | length -%}
  {%- if n_chips > 0 %}
  {%- set chip_gap = margin * 0.4 -%}
  {%- set chip_w = (safe_w - chip_gap * (n_chips - 1)) / n_chips -%}
  {%- for chip in view.delta_chips %}
  {%- set cx = margin + loop.index0 * (chip_w + chip_gap) %}
  <rect x="{{ cx }}" y="{{ ns.y }}" width="{{ chip_w }}" height="{{ chip_h }}"
        rx="{{ chip_h / 2 }}" fill="{{ pal.chip_bg }}"/>
  <text x="{{ cx + chip_w * 0.5 }}" y="{{ ns.y + chip_h * 0.40 }}" text-anchor="middle"
        font-family="{{ sans }}" font-weight="400" font-size="{{ chip_label_size }}"
        fill="{{ pal.muted }}">{{ chip.label }}</text>
  <text x="{{ cx + chip_w * 0.5 }}" y="{{ ns.y + chip_h * 0.76 }}" text-anchor="middle"
        font-family="{{ mono }}" font-weight="700" font-size="{{ chip_value_size }}"
        fill="{{ dir_color(chip.direction) }}">{{ arrow_glyph(chip.direction) }} {{ chip.value }}</text>
  {%- endfor %}
  {%- set ns.y = ns.y + chip_h + margin * 0.85 %}
  {%- endif %}

  {#- plan target/stop callouts -#}
  {%- set n_callouts = view.callouts | length -%}
  {%- if n_callouts > 0 %}
  {%- set co_gap = margin * 0.4 -%}
  {%- set co_w = (safe_w - co_gap * (n_callouts - 1)) / n_callouts -%}
  {%- for co in view.callouts %}
  {%- set cx = margin + loop.index0 * (co_w + co_gap) %}
  <text x="{{ cx }}" y="{{ ns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ callout_label_size }}" fill="{{ pal.muted }}">{{ co.label }}</text>
  <text x="{{ cx }}" y="{{ ns.y + callout_value_size + 4 }}" font-family="{{ mono }}"
        font-weight="700" font-size="{{ callout_value_size }}" fill="{{ pal.fg }}">{{ co.value }}</text>
  {%- endfor %}
  {%- endif %}

{%- else %}
{#- ============================== TELEGRAM (landscape, two-column) ============================== -#}
  {%- set col_split = W * 0.55 -%}
  {%- set left_x = margin -%}
  {%- set left_w = col_split - margin -%}
  {%- set right_x = col_split + margin * 0.5 -%}
  {%- set right_w = W - right_x - margin -%}

  {%- set headline_size = [W * 0.050, 30] | max -%}
  {%- set risk_note_size = [W * 0.018, 13] | max -%}
  {%- set hero_label_size = [W * 0.018, 13] | max -%}
  {%- set hero_value_size = H * 0.130 -%}
  {%- set chip_h = [H * 0.11, 40] | max -%}
  {%- set chip_label_size = [W * 0.0125, 10] | max -%}
  {%- set chip_value_size = [W * 0.017, 13] | max -%}
  {%- set callout_value_size = [W * 0.017, 13] | max -%}
  {%- set callout_label_size = [W * 0.0115, 9] | max -%}

  {%- set lns = namespace(y = margin + logo_size + margin * 1.1) -%}
  {%- set lns.y = lns.y + badge_h %}

  {% if side_label %}
  <rect x="{{ left_x }}" y="{{ lns.y - badge_h }}" width="{{ badge_h * 2.5 }}" height="{{ badge_h }}"
        rx="{{ badge_h / 2 }}" fill="{{ side_color }}" opacity="0.18"/>
  <text x="{{ left_x + badge_h * 1.25 }}" y="{{ lns.y - badge_h * 0.32 }}" text-anchor="middle"
        font-family="{{ sans }}" font-weight="700" font-size="{{ badge_size }}"
        fill="{{ side_color }}">{{ side_label }}</text>
  {% endif %}

  {%- set lns.y = lns.y + headline_size + margin * 0.4 %}
  <text x="{{ left_x }}" y="{{ lns.y }}" font-family="{{ sans }}" font-weight="800"
        font-size="{{ headline_size }}" fill="{{ pal.fg }}">{{ view.headline }}</text>

  {%- if view.subhead %}
  {%- set lns.y = lns.y + risk_note_size + margin * 0.3 %}
  <text x="{{ left_x }}" y="{{ lns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ risk_note_size }}" fill="{{ pal.muted }}">{{ view.subhead }}</text>
  {%- endif %}

  {%- if view.text_fields is defined and view.text_fields.risk_note is defined and view.text_fields.risk_note %}
  {%- set lns.y = lns.y + risk_note_size + margin * 0.3 %}
  <text x="{{ left_x }}" y="{{ lns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ risk_note_size }}" fill="{{ pal.accent }}">{{ view.text_fields.risk_note }}</text>
  {%- endif %}

  {#- hero block anchored in the lower half of the left column -#}
  {%- set hero_y = H * 0.72 %}
  <text x="{{ left_x }}" y="{{ hero_y - hero_value_size * 0.90 }}"
        font-family="{{ sans }}" font-weight="600" font-size="{{ hero_label_size }}"
        fill="{{ pal.muted }}">{{ view.hero.label }}</text>
  <text x="{{ left_x }}" y="{{ hero_y }}"
        font-family="{{ mono }}" font-weight="700" font-size="{{ hero_value_size }}"
        fill="{{ hero_fill() }}"><tspan font-size="{{ hero_value_size * 0.48 }}">{{ arrow_glyph(view.hero.direction) }} </tspan>{{ view.hero.value }}</text>

  {%- set rns = namespace(y = margin + logo_size + margin * 1.1) -%}

  {#- delta chips: stacked vertically down the right column -#}
  {%- set n_chips = view.delta_chips | length -%}
  {%- if n_chips > 0 %}
  {%- set chip_gap = margin * 0.32 -%}
  {%- for chip in view.delta_chips %}
  <rect x="{{ right_x }}" y="{{ rns.y }}" width="{{ right_w }}" height="{{ chip_h }}"
        rx="{{ chip_h / 2 }}" fill="{{ pal.chip_bg }}"/>
  <text x="{{ right_x + right_w * 0.5 }}" y="{{ rns.y + chip_h * 0.40 }}" text-anchor="middle"
        font-family="{{ sans }}" font-weight="400" font-size="{{ chip_label_size }}"
        fill="{{ pal.muted }}">{{ chip.label }}</text>
  <text x="{{ right_x + right_w * 0.5 }}" y="{{ rns.y + chip_h * 0.78 }}" text-anchor="middle"
        font-family="{{ mono }}" font-weight="700" font-size="{{ chip_value_size }}"
        fill="{{ dir_color(chip.direction) }}">{{ arrow_glyph(chip.direction) }} {{ chip.value }}</text>
  {%- set rns.y = rns.y + chip_h + chip_gap %}
  {%- endfor %}
  {%- endif %}

  {#- plan target/stop callouts: stacked label/value rows in the right column -#}
  {%- if view.callouts | length > 0 %}
  {%- for co in view.callouts %}
  <text x="{{ right_x }}" y="{{ rns.y }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ callout_label_size }}" fill="{{ pal.muted }}">{{ co.label }}</text>
  <text x="{{ right_x + right_w }}" y="{{ rns.y }}" text-anchor="end" font-family="{{ mono }}"
        font-weight="700" font-size="{{ callout_value_size }}" fill="{{ pal.fg }}">{{ co.value }}</text>
  {%- set rns.y = rns.y + callout_value_size + margin * 0.28 %}
  {%- endfor %}
  {%- endif %}
{%- endif %}

  <!-- footer + watermark -->
  <text x="{{ margin }}" y="{{ H - margin * 0.55 }}" font-family="{{ sans }}" font-weight="400"
        font-size="{{ footer_size }}" fill="{{ pal.muted }}">{{ view.footer }}</text>
  {%- if brand.watermark %}
  <text x="{{ W - margin }}" y="{{ H - margin * 0.55 }}" text-anchor="end"
        font-family="{{ sans }}" font-weight="700" font-size="{{ footer_size }}"
        fill="{{ pal.muted }}" opacity="0.6">{{ brand.logo_text }}</text>
  {%- endif %}

  {%- if state and state.name == 'expired' %}
  </g>
  {%- endif %}

  {#- ================================ STATE LAYER (rendered on top) ================================ -#}
  {%- if state %}
  {%- if state.name == 'pending' %}
  {{ state_ribbon(st_title, st_color) }}
  {%- else %}
  {%- if state.name == 'rejected' %}
  <rect x="0" y="0" width="{{ W }}" height="{{ H }}" fill="{{ pal.bg }}" opacity="0.55"/>
  {%- endif %}
  {{ state_stamp(st_title, st_color, st_lines) }}
  {%- endif %}
  {%- endif %}
</svg>
